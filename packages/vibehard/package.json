{
  "name": "vibehard",
  "version": "0.2.0",
  "description": "Exact e2e test selection via automatically recorded, machine-verified symbol mapping",
  "license": "MIT",
  "author": {
    "name": "muellerluke",
    "url": "https://github.com/muellerluke"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muellerluke/vibehard.git",
    "directory": "packages/vibehard"
  },
  "homepage": "https://github.com/muellerluke/vibehard#readme",
  "bugs": {
    "url": "https://github.com/muellerluke/vibehard/issues"
  },
  "keywords": [
    "e2e",
    "test-selection",
    "test-impact-analysis",
    "testing",
    "playwright",
    "puppeteer",
    "cypress",
    "coverage",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "import": "./dist/playwright.js",
      "require": "./dist/playwright.cjs"
    },
    "./puppeteer": {
      "types": "./dist/puppeteer.d.ts",
      "import": "./dist/puppeteer.js",
      "require": "./dist/puppeteer.cjs"
    },
    "./cypress": {
      "types": "./dist/cypress.d.ts",
      "import": "./dist/cypress.js",
      "require": "./dist/cypress.cjs"
    },
    "./cypress/node": {
      "types": "./dist/cypress-node.d.ts",
      "import": "./dist/cypress-node.js",
      "require": "./dist/cypress-node.cjs"
    }
  },
  "bin": {
    "vibehard": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "tsup && chmod +x dist/cli.js",
    "prepublishOnly": "tsup && chmod +x dist/cli.js",
    "perf": "node perf/run-perf.mjs"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@jridgewell/gen-mapping": "^0.3.13",
    "@playwright/test": "^1.59.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.27.7",
    "playwright": "1.59.0",
    "tsup": "^8.3.5",
    "vitest": "^3.0.0",
    "puppeteer": "^24.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0 <2.0.0",
    "puppeteer": ">=22.0.0",
    "cypress": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "puppeteer": {
      "optional": true
    },
    "cypress": {
      "optional": true
    }
  }
}
